[Unit]
Description=Phoenix native service stack (private backends behind nginx)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=phoenix
Group=phoenix
# `/srv/phoenix/current` is an atomic symlink to a detached, clean Git
# worktree.  Never run production from the repository used to create releases.
WorkingDirectory=/srv/phoenix/current
EnvironmentFile=/etc/phoenix/phoenix.env
Environment=PHOENIX_ENV_FILE=/etc/phoenix/phoenix.env
Environment=PHOENIX_BIND_HOST=127.0.0.1
Environment=PHOENIX_REQUIRE_PRODUCTION_CONFIG=true
Environment=PHOENIX_LOG_DIR=/var/log/phoenix
Environment=PHOENIX_DATA_DIR=/var/lib/phoenix
ExecStartPre=/usr/bin/test -L /srv/phoenix/current
ExecStartPre=/usr/bin/test -r /etc/phoenix/phoenix.env
ExecStartPre=/usr/bin/test -d /var/lib/phoenix/account
ExecStartPre=/usr/bin/test -d /var/lib/phoenix/classic
ExecStartPre=/usr/bin/test -d /var/lib/phoenix/ota
ExecStart=/usr/bin/bash /srv/phoenix/current/scripts/run-compose-stack.sh
Restart=on-failure
RestartSec=5s
KillMode=control-group
TimeoutStopSec=120s
UMask=0077

# Keep the native process tree away from the host's privileged surfaces. Node
# still needs network access to the configured private peers and outbound APIs.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RemoveIPC=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/phoenix /var/log/phoenix

[Install]
WantedBy=multi-user.target
