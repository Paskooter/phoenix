# Phoenix configuration — copy to `.env` and edit. Every variable here is optional unless
# marked REQUIRED; real environment variables always override .env values.
# Loaded automatically by every Phoenix service/launcher (packages/common/src/dotenv.js).

# ── Web portal / admin UI (packages/account) ────────────────────────────────
# REQUIRED to use the admin UI: password for /admin (unset = admin face disabled).
ADMIN_PASSWORD=
# The `region` written into adopted robots' credentials.json (any name; robots resolve
# it via the repoint script, not DNS, unless you set up <region>.jibo.com yourself).
ETCO_account_region=phx
# Where the account store persists (accounts/loops/tokens/sessions).
#ETCO_account_dataFile=packages/account/data/store.json
# Set true when serving the portal over HTTPS so session cookies are Secure.
#ETCO_account_secureCookies=true

# ── Hub auth ────────────────────────────────────────────────────────────────
# Secret that signs/verifies robot hub tokens. CHANGE THIS for any non-LAN deployment.
HUB_TOKEN_SECRET=dev-hub-token-secret
# true = hub accepts unauthenticated robots (LAN convenience). Set false for real auth.
DISABLE_AUTH=true
# When set (and DISABLE_AUTH=false), the hub validates each token's accessKeyId against the
# account service so you can revoke a robot by deactivating it. The bundled launchers wire this
# automatically (run-compose-stack -> localhost:9011; docker-compose -> account:8080); set it
# only when running the hub standalone.
#ETCO_hub_accountUrl=http://localhost:9011

# ── Speech + LLM backends ───────────────────────────────────────────────────
# Parakeet ASR host (POST /transcribe). Unset = launcher probes REAL_PARAKEET, then mock.
#PARAKEET_URL=http://192.168.1.252:6972
#REAL_PARAKEET=http://192.168.1.252:6972
# OpenAI-compatible endpoint for the answer-skill + parser LLM fallback (e.g. LM Studio).
#LLM_URL=http://192.168.1.252:1234/v1
#LLM_MODEL=google/gemma-4-e4b
#REAL_LLM=http://192.168.1.252:1234/v1

# ── Personal report ─────────────────────────────────────────────────────────
# Original report-skill names. Empty/unset values use the source defaults:
# NET_lasso=lasso:8080, NET_settings=settings.jibo.aws, prefsFromConfig=false.
# Set prefsFromConfig=true to read resources/report-prefsConfig.json (enables commute/calendar).
#NET_lasso=localhost:9007
#NET_settings=settings.jibo.aws
#prefsFromConfig=true
#ETCO_server_port=9003
# Launcher convenience alias: run-compose-stack maps PREFS_FROM_CONFIG to prefsFromConfig.
# Phoenix compatibility aliases are used only when the corresponding source name is absent:
#NET_data=localhost:9007
#ETCO_report_prefsFromConfig=true

# ── OTA update server (packages/ota) ────────────────────────────────────────
# Externally reachable base URL for package downloads (default: derived from request Host).
#OTA_PUBLIC_URL=
#ETCO_ota_dataDir=packages/ota/data
#ETCO_ota_manifest=packages/ota/manifest.json

# ── Service discovery (compose/native launchers set these; override to split hosts) ──
#NET_parser=localhost:9005
#NET_history=localhost:9006
#NET_data=localhost:9007
# Setting NET_skills opts into Phoenix's shared skill host and selects
# skills-phoenix.json unless ETCO_hub_skillsConfig selects another index.
# Without it, the gateway uses Pegasus's original skills-local.json URLs.
#NET_skills=localhost:9001
#NET_ota=localhost:9010

# ── Optional portable compiled NLU profile ─────────────────────────────────
# Install a reviewed JSON/gzip bundle with:
#   node scripts/install-nlu-snapshot.mjs --input BUNDLE_DIR --output runtime/nlu-snapshot
# Native launcher opt-in (the AST runtime remains the default when these stay commented):
#PHOENIX_NLU_RUNTIME=compiled-fst
#PHOENIX_NLU_COMPILED_SNAPSHOT_MANIFEST=runtime/nlu-snapshot/profile.json
# Docker Compose opt-in: set the host directory and the container-visible manifest path.
#PHOENIX_NLU_SNAPSHOT_DIR=./runtime/nlu-snapshot
#PHOENIX_NLU_RUNTIME=compiled-fst
#PHOENIX_NLU_COMPILED_SNAPSHOT_MANIFEST=/phoenix/runtime/nlu-snapshot/profile.json
# The target bundle contains only portable JSON/gzip data; original Jibo binaries are not
# required on the deployment host. Do not enable the runtime until installation succeeds.
