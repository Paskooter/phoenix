# Phoenix configuration — copy to `.env`, edit every REQUIRED value, then chmod 0600.
# The production Compose file intentionally refuses to start without a real hub secret,
# an explicit OTA URL, and an explicit Classic public URL. Real environment variables
# always override .env values.
# Loaded automatically by every Phoenix service/launcher (packages/common/src/dotenv.js).
#
# You can also edit non-secret values from the console, at /app#/admin/config, if your account
# has the isAdmin flag. In a hardened container deployment the environment file is not mounted
# writable, so manage it on the host and restart the affected services. Two things it will tell
# you that are worth knowing here too:
#   * Services read these values at startup. Changing one takes effect when the services that
#     read it are next restarted — nothing is applied to a running process.
#   * A variable set in the real environment always wins over this file, so the console shows
#     such a setting as read-only rather than writing a line that would never take effect.

# ── Web portal / admin UI (packages/account) ────────────────────────────────
# The admin face has NO shared password. Administrator access is the `isAdmin` flag
# on an account, checked server-side on every /api/admin/* route. Grant it after
# signing up:
#     node scripts/portal-grant-admin.mjs --email you@example.com
#     node scripts/portal-grant-admin.mjs --list
# The `region` written into adopted robots' credentials.json. The robot's native client
# builds `<region>.jibo.com` (REST) and `<region>-socket.jibo.com` (notification socket)
# from it, and scripts/ensure-tls-certs.mjs issues the serving certificate for the region
# in PHOENIX_TLS_REGIONS (default `api`). Keep the two aligned or the robot rejects the
# server. `api` is the region the physical Jibo reports; the old `phx` value here was a
# placeholder and is NOT a real region.
ETCO_account_region=api
# Public IP address the robot should use for its managed /etc/hosts entries.
# This is displayed in the signed-in portal's “Claim an existing Jibo” command;
# it is not a URL and must be reachable from the robot. Leave it unset only for
# a development instance, where the portal will require the operator to fill it
# in manually.
#ETCO_account_repointHost=203.0.113.10
# Where the account store persists (accounts/loops/tokens/sessions).
#ETCO_account_dataFile=packages/account/data/store.json
# Native immutable-release deployment: set PHOENIX_DATA_DIR in the systemd unit
# (for example /var/lib/phoenix). The native launcher then places this store,
# member photos, Classic state, OTA packages, History, and Lasso state outside
# the disposable checkout. Do not put PHOENIX_DATA_DIR under a release path.
#PHOENIX_DATA_DIR=/var/lib/phoenix
# Production portal is HTTPS behind nginx; never turn this off on an internet-facing service.
ETCO_account_secureCookies=true
# Public origin used in activation, password-reset, email-change, and
# invitation links. It must be the browser's HTTPS origin, not localhost,
# a container name, or a trailing path.
#ETCO_account_portalUrl=https://portal.example.com
#PHOENIX_SITE_URL=https://portal.example.com
# Mail is required for a public portal. With SMTP configured, new portal
# accounts stay inactive until the mailbox confirms the activation link; the
# same transport delivers password recovery, email-change confirmation, and
# security notices. Keep the password in this mode-0600 file or a secret
# manager—never in Git, browser configuration, or a systemd unit command line.
#ETCO_account_mailSmtpHost=smtp.example.com
#ETCO_account_mailSmtpPort=587
#ETCO_account_mailSmtpSecure=false
#ETCO_account_mailSmtpRequireTLS=true
#ETCO_account_mailSmtpUser=relay-user
#ETCO_account_mailSmtpPassword=replace-with-a-secret
#ETCO_account_mailSmtpAuthMethod=LOGIN
#ETCO_account_mailSmtpTimeoutMs=10000
#ETCO_account_mailFrom=no-reply@example.com
# Verify the From address/domain at the relay before launch. A successful SMTP
# login alone does not prove the relay will accept or deliver that sender.
# Browser-app notifications use the Web Push standard directly (no Firebase SDK
# or third-party JavaScript). Generate one VAPID key pair on the target host:
#   node scripts/generate-web-push-vapid.mjs --subject mailto:ops@example.com
# Paste its output only into this mode-0600 file or a secret manager, then
# restart Account. The private key is never sent to browsers or returned by the
# API. Keep it distinct per Phoenix installation; replacing it invalidates old
# browser subscriptions, which users can recreate from Account settings.
#ETCO_account_webPushSubject=mailto:ops@example.com
#ETCO_account_webPushPublicKey=<generated-public-key>
#ETCO_account_webPushPrivateKey=<generated-private-key>
# Browser endpoints are restricted to Apple, Mozilla and FCM by default to keep
# a signed-in subscription from becoming an SSRF primitive. Add only a reviewed
# public browser-push hostname if you operate another compatible provider.
#ETCO_account_webPushEndpointHosts=push.example.net
# Member photos use the local Phoenix adapter. Set PHOTO_PUBLIC_URL to the
# externally reachable Classic/TLS origin that forwards GET /member-photos/:key;
# do not use account:8080, localhost, or another backend-only address here.
#PHOTO_PUBLIC_URL=https://region.example
#PHOTO_DIRECTORY=packages/account/data/member-photos
# Equivalent ETCO names are accepted by the Account entrypoint:
#ETCO_account_photoBaseUrl=https://region.example
#ETCO_account_photoDirectory=packages/account/data/member-photos
# CLASSIC_PUBLIC_URL may supply the same public origin in compose/native launchers.
#CLASSIC_PUBLIC_URL=https://region.example

# ── Hub auth ────────────────────────────────────────────────────────────────
# REQUIRED. Generate a unique value (at least 32 random bytes) and never commit it:
#   openssl rand -base64 48
HUB_TOKEN_SECRET=
# REQUIRED for production: unauthenticated hub sessions are disabled by default.
DISABLE_AUTH=false
# REQUIRED for production: authenticate private Account-to-Classic/skills peer
# calls. Generate a separate value; do not reuse a robot access key or place it
# in browser-side configuration.
#   openssl rand -hex 32
ETCO_account_internalPeerToken=
# Native launcher bind address. Loopback keeps nginx as the only public ingress.
# Set a private/VPN address only after adding an explicit firewall policy.
PHOENIX_BIND_HOST=127.0.0.1
# When set (and DISABLE_AUTH=false), the hub validates each token's accessKeyId against the
# account service so you can revoke a robot by deactivating it. The bundled launchers wire this
# automatically (run-compose-stack -> localhost:9011; docker-compose -> account:8080); set it
# only when running the hub standalone.
#ETCO_hub_accountUrl=http://localhost:9011
# Optional account verification bounds the complete HTTP response, including its body.
#ETCO_hub_accountVerifyTimeoutMs=5000

# ── Speech + LLM backends ───────────────────────────────────────────────────
# Parakeet ASR host (POST /transcribe). Unset = launcher probes REAL_PARAKEET, then mock.
#PARAKEET_URL=http://192.168.1.252:6972
#REAL_PARAKEET=http://192.168.1.252:6972
# OpenAI-compatible endpoint for the answer-skill + parser LLM fallback (e.g. LM Studio).
#LLM_URL=http://192.168.1.252:1234/v1
#LLM_MODEL=google/gemma-4-e4b
#REAL_LLM=http://192.168.1.252:1234/v1

# ── Personal report ─────────────────────────────────────────────────────────
# Original report-skill names. Empty/unset values use the source defaults:
# NET_lasso=lasso:8080, NET_settings=settings.jibo.aws, prefsFromConfig=false.
# Set prefsFromConfig=true to read resources/report-prefsConfig.json (enables commute/calendar).
#NET_lasso=localhost:9007
#NET_settings=settings.jibo.aws
#prefsFromConfig=true
#ETCO_server_port=9003
# Launcher convenience alias: run-compose-stack maps PREFS_FROM_CONFIG to prefsFromConfig.
# Phoenix compatibility aliases are used only when the corresponding source name is absent:
#NET_data=localhost:9007
#ETCO_report_prefsFromConfig=true

# ── OTA update server (packages/ota) ────────────────────────────────────────
# REQUIRED for public deployments. Use the fixed HTTPS origin that serves OTA packages;
# leaving it empty makes Compose fail closed instead of deriving URLs from Host headers.
OTA_PUBLIC_URL=
# Required in production: a unique random secret for the private Classic -> OTA
# hop (for example: `openssl rand -hex 32`). Do not reuse HUB_TOKEN_SECRET.
ETCO_ota_internalPeerToken=
#ETCO_ota_dataDir=packages/ota/data
#ETCO_ota_manifest=packages/ota/manifest.json

# ── Service discovery (compose/native launchers set these; override to split hosts) ──
#NET_parser=localhost:9005
#NET_history=localhost:9006
#NET_data=localhost:9007
# Setting NET_skills opts into Phoenix's shared skill host and selects
# skills-phoenix.json unless ETCO_hub_skillsConfig selects another index.
# Without it, the gateway uses Pegasus's original skills-local.json URLs.
#NET_skills=localhost:9001
#NET_ota=localhost:9010

# ── Optional portable compiled NLU profile ─────────────────────────────────
# Install a reviewed JSON/gzip bundle with:
#   node scripts/install-nlu-snapshot.mjs --input BUNDLE_DIR --output runtime/nlu-snapshot-v1
# Native launcher opt-in (the AST runtime remains the default when these stay commented):
#PHOENIX_NLU_RUNTIME=compiled-fst
#PHOENIX_NLU_COMPILED_SNAPSHOT_MANIFEST=runtime/nlu-snapshot-v1/profile.json
# Compose: set the installed host directory and include the optional overlay:
#   docker compose -f docker-compose.yml -f docker-compose.nlu-snapshot.yml up
# The overlay selects compiled-fst and sets the container-visible manifest path.
#PHOENIX_NLU_SNAPSHOT_DIR=./runtime/nlu-snapshot-v1
# The target bundle contains only portable JSON/gzip data; original Jibo binaries are not
# required on the deployment host. Do not enable the runtime until installation succeeds.
# Choose one profile: do not combine a snapshot with PHOENIX_NLU_COMPILED_FST,
# PHOENIX_NLU_COMPILED_FACTORY_DIR, PHOENIX_NLU_COMPILED_RULES_DIR or its FST_SHA256.
# runtime/ is excluded from Git and Docker build contexts. Install updates to a new
# versioned directory, then change the selected path; existing installs are never replaced.

# Classic notification snapshots: choose a private persistent path for deployment.
# The authenticated robot launcher uses its own private run directory.
# ETCO_classic_notificationFile=/private/phoenix/notifications.json

# Classic GQA attribution snapshots: the default source-shaped Question route
# has no external provider configured, but successful injected/provider answers
# persist attribution here. Use a path on durable private storage and assign
# each Classic process its own path; the local snapshot store is single-writer.
# ETCO_gqa_attributionFile=/private/phoenix/gqa-attribution.json

# Public URL wiring (REQUIRED by hardened Compose; use the same HTTPS origin nginx proxies
# to Classic for member photos and robot-facing generated links). Never use localhost or a
# Compose service name here.
CLASSIC_PUBLIC_URL=
PHOTO_PUBLIC_URL=
