# Contract-only image: the API without NeMo, torch or CUDA.
#
# Runs the same app against an injected recognizer, so the wire contract and the
# streaming protocol can be exercised on a machine with no GPU. It cannot
# transcribe anything. The real image is Dockerfile.
FROM python:3.10-slim

WORKDIR /srv
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

RUN apt-get update && \
    apt-get install -y --no-install-recommends ffmpeg && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt pytest httpx

COPY app ./app
COPY tests ./tests

EXPOSE 6972
CMD ["uvicorn", "app.server:app", "--host", "0.0.0.0", "--port", "6972"]
