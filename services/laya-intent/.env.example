# Private LAN deployment on the Blackwell host. Do not bind this service to
# 0.0.0.0 or publish it through the public nginx vhost.
LAYA_BIND_ADDRESS=192.168.1.252
LAYA_PORT=6973

# Generate a separate random token and put the same value in Phoenix's private
# environment. Never commit or put this in browser/robot configuration.
# openssl rand -hex 32
LAYA_AUTH_TOKEN=

LAYA_DEFAULT_PROFILE=phoenix-core
# Used only by the explicit `--profile bootstrap` checkpoint fetch job. The
# serving container mounts the verified checkpoint read-only.
LAYA_MODEL_REPO=convaiinnovations/laya
LAYA_MODEL_REVISION=1c5edc17a7acd8701df6fc341c0d179f1c62c982
LAYA_MAX_CONCURRENCY=2
LAYA_QUEUE_TIMEOUT_MS=50
LAYA_INFERENCE_TIMEOUT_MS=750
