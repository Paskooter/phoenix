TopRule = (
    ($* $POSTCONTROL_NO_COLOR $*) {intent=POSTCONTROL_NO_COLOR._intent} |
    ($* $LIGHTS_COLOR $*) {intent=LIGHTS_COLOR._intent}{color=LIGHTS_COLOR._color}
){priority='HIGH'};

### (no prompt ) ###

POSTCONTROL_NO_COLOR =
(
    $BRIGHTER {_intent = 'lightsUp'} |
    $DIMMER {_intent = 'lightsDown'} |
    $WARMUP {_intent = 'lightsWarm'} |
    $COOLDOWN {_intent = 'lightsCool'} |
    $ALLTHEWAYUP {_intent = 'lightsUpCompletely'} |
    $OFF {_intent = 'lightsOff'} |
    $ON {_intent = 'lightsOn'} |
    $NOMATCH {_intent = 'noMatch'}
);

LIGHTS_COLOR =
(
    $MAKE $* ?( $LIGHT | $THEM ) $ENT_LIGHT_COLOR
)
{_intent='lightsColor'}{_color=ENT_LIGHT_COLOR._color}
;

BRIGHTER =
(
    ( (turn|bring) up $* $LIGHT ) |
    ( (turn|bring|make) $* $LIGHT brighter ) |
    ( (turn|bring) $* $LIGHT up ) |
    ( $ADJUST $* ($LIGHT $HIGHER)|($HIGHER $w03 $LIGHT) ) |
    ( $LIGHT $HIGHER ) |
    ( $BRIGHTEN $* $LIGHT) |
    ( ?even ( brighter | lighter ) ) |
    ((turn|bring) $THEM up )
);
DIMMER =
(
    ( (turn|bring) down $* $LIGHT ) |
    ( (turn|bring|make) $* $LIGHT $DARKER ) |
    ( $ADJUST $* ($LIGHT $DARKER)|($DARKER $w03 $LIGHT) ) |
    ( $LIGHT $w03 $DARKER ) |
    ( ( $DIM  |lower ) $* $LIGHT ) |
    ( ?even ( dimmer | lower ) ) |
    ( (turn|bring) $THEM down )
);
WARMUP =
(
    ( (turn|bring|make) $* $LIGHT $WARMER ) |
    ( warm $* $LIGHT ) |
    ( ?even ( warmer | hotter | cozier ) )
);
COOLDOWN =
(
    ( (turn|bring|make) $* $LIGHT $COOLER ) |
    ( cool $* $LIGHT ) |
    ( ?even ( cooler | colder ) )
);
ALLTHEWAYUP =
(
    ( ?(turn|bring) $* $LIGHT all ?the way ?up ) |
    ( ?(turn|bring|make) $* $LIGHT ?as bright as possible ) |
    ( ?(turn|set) $* $LIGHT $* (maximum|max) ?brightness ) |
    ( all the way up ) |
    ( completely up ) |
    ( ( make | $ADJUST ) $* $LIGHT $* brightest )
);
OFF =
(
    ( ($SWITCH|shut off)|shutoff $* $LIGHT ) |
    ( $SWITCH|shut $* $LIGHT off ) |
    ( kill $* $LIGHT ) |
    ( $SWITCH|shut ?$THEM off ) |
    ( kill $THEM ) |
    ( [light?(?(\')s)] off )
);
ON =
(
    ( $SWITCH on $* $LIGHT ) |
    ( $SWITCH $* $LIGHT on ) |
    ( ( let | may ) there be light ) |
    ( $SWITCH ?$THEM ?back on ) |
    ( [light?(?(\')s)] on )
);
NOMATCH =
( $* );

