TopRule = ($* $ALARMTIMERCHANGE $*) {intent = ALARMTIMERCHANGE._intent}{priority='HIGH'};

#You've already got a timer set for ${promptTime}. Do you want to replace that one?

ALARMTIMERCHANGE =
	(
		($factory:yes_no{_intent = yes_no._nl}) |
		$YES {_intent=YES._intent} |
		$NO {_intent=NO._intent}
	)
	{%
		if (this._intent == 'yes') {this._intent = 'delete'}
		else if (this._intent == 'no') {this._intent = 'keep'}
	%}
;

YES =
	(
		guess | gas |
		(yes | yup | sure | okay) |
		(don\'t|(do not) $V_KEEP ?(it|that)) |
        ($V_DELETE ?(it | that))
	)
{_intent='delete'}
;

NO =
	(
		know | snow | now |
		(no | nope | don\'t | (no way)) |
		(don\'t|(do not) $V_DELETE ?(it|that)) |
        ($V_KEEP ?(it | that))
	)
{_intent='keep'}
;

V_KEEP = keep|save|preserve;
V_DELETE = cancel|replace|delete|trash|discard|(throw ?(it|that) out|away);
