TopRule = ($* $SETSHORTERTIMER $*) {intent = SETSHORTERTIMER._intent}{priority='HIGH'};

#I can only go up to 24 hours; do you want to set a shorter timer?

SETSHORTERTIMER =
	(
		($factory:yes_no{_intent = yes_no._nl}) |
		$YES {_intent=YES._intent} |
		$NO {_intent=NO._intent}
	)
;

YES =
	(
		guess | gas |
		(yes | yup | sure | okay) |
		(don\'t|(do not) $V_KEEP ?(it|that)) |
        ($V_REPLACE ?(it | that)) |
        ( i do ) |
        fine |
        ( i ( think | guess | suppose ) ?so ) |
        ( sounds good )
	)
{_intent='yes'}
;

NO =
	(
		know | snow | now |
		(no | nope | don\'t | (no way)) |
		(don\'t|(do not) $V_REPLACE ?(it|that)) |
        ($V_KEEP ?(it | that)) |
        ( i ( ( do not ) | don\'t ) ) |
        ( i\'m good|fine )
	)
{_intent='no'}
;

V_KEEP = keep|save|preserve;
V_REPLACE = cancel|replace|delete|trash|discard|(throw ?(it|that) out|away);
