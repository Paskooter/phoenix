TopRule = ($* $DOWNLOAD $*) {intent = DOWNLOAD._intent}{priority='HIGH'};

DOWNLOAD =
    (
        ($factory:yes_no {_intent = yes_no._nl}) |
        ($YES_OTHER {_intent=YES_OTHER._intent}) |
        ($NO_OTHER {_intent=NO_OTHER._intent}) |
        ($NEVER {_intent=NEVER._intent})
    )
;

YES_OTHER =
    (
        guess | gas |
        (?why yes | yeah | yep) |
        (?yes go ahead) |
        ((go for)|do it ?now) |
        (perfect) |
        (why not) |
        (install ?it)|
        (download ?it)
    )
{_intent='yes'}
;

NO_OTHER =
    (
        know | snow |
        (no thanks | (thank you)) |
        (?no ?(i\'m|(i am)) not ?ready ?yet) |
        (wait|(hold on) ?(a sec|minute|second|moment))|
        (later)|
        (cancel)|
        (forget it)|
        (go back)|
        (exit)|
        (escape)|
        (not now)|
        ((don\'t|(do not)) (install|download|do) ?it ?now)
    )
{_intent='no'}
;

NEVER = (never | (don\'t|(do not) $* ever) ?((install|download) ?it)) {_intent='never'};
