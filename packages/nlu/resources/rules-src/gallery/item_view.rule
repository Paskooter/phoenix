TopRule =
($*
	(
		$MENU_INTENTS {intent=MENU_INTENTS._intent}
	)
$*){domain='gui_command'}{priority='HIGH'} |
($*
	(
		$ITEM_INTENTS {intent=ITEM_INTENTS._intent}
	)
$*){domain='gallery'}{priority='HIGH'}
;

ITEM_INTENTS =
(
	$DELETE {_intent=DELETE._intent}
)
;

MENU_INTENTS =
(
	$PAUSE {_intent=PAUSE._intent} |
	$CLOSE {_intent=CLOSE._intent}
)
;


PAUSE = $V_PAUSE {_intent='pause'};
DELETE = $V_DELETE {_intent='delete'};
CLOSE = $V_CLOSE {_intent='close'};



### USEFUL VOCABULARY ###
V_PAUSE = (pause | stop | wait | (hold on));
V_DELETE = (discard | delete | erase | (get $* rid) | trash | toss | (throw ($* (out | away))));
V_CLOSE = (close|exit|escape|done|cancel|(back ?($* gallery))|save|keep);
