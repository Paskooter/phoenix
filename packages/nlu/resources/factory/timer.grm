# Bounded source grammar for the reference factory:timer contract.
# Numeric words and digits map to the private _value field consumed by the
# clock/timer_set_value rule; the rule itself supplies public intent/domain tags.
TopRule = $TIMER;

TIMER =
    ($NUMBER {_hours=NUMBER._value} [hour?s])
        {_minutes='null'}{_seconds='null'} |
    ($NUMBER {_minutes=NUMBER._value} [minute?s])
        {_hours='null'}{_seconds='null'} |
    ($NUMBER {_seconds=NUMBER._value} [second?s])
        {_hours='null'}{_minutes='null'} |
    ($NUMBER {_hours=NUMBER._value} [hour?s] and $NUMBER {_minutes=NUMBER._value} [minute?s])
        {_seconds='null'} |
    ($NUMBER {_hours=NUMBER._value} [hour?s] and $NUMBER {_seconds=NUMBER._value} [second?s])
        {_minutes='null'} |
    ($NUMBER {_minutes=NUMBER._value} [minute?s] and $NUMBER {_seconds=NUMBER._value} [second?s])
        {_hours='null'} |
    ($NUMBER {_hours=NUMBER._value} [hour?s] and $NUMBER {_minutes=NUMBER._value} [minute?s] and $NUMBER {_seconds=NUMBER._value} [second?s]);

NUMBER =
(zero|0){_value='0'} |
(one|1){_value='1'} |
(two|2){_value='2'} |
(three|3){_value='3'} |
(four|4){_value='4'} |
(five|5){_value='5'} |
(six|6){_value='6'} |
(seven|7){_value='7'} |
(eight|8){_value='8'} |
