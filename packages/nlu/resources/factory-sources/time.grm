TopRule = $top_time
            {%
                this._time_nl=this.top_time.nl
                this._time_time=this.top_time.time
                this._time_rel=this.top_time.rel
                this._time_ampm=this.top_time.ampm
                this._time_dow = this.top_time.dow
                delete this.top_time
            %}
          ;

top_time =
        (
            (
                ?(?$filler $day_of_week)
                ?(?$filler $AM_PM_spoken)
                ?$filler ?$time_modifier
                [ $hour_number  {%
                                    this.hour = this.hour_number._nl
                                    this.min = '00'
                                %}
                  ?(?: $minutes_number{%this.min=this.minutes_number._nl%}) ]
                  ?(o\'clock)
                  ?[ $AM_PM ]
                  ?(o\'clock)
                  ?(?$filler $AM_PM_spoken)
                  ?(?$filler $day_of_week)
                  ?(?$filler $AM_PM_spoken)
            )
            |
            (
                ?(?$filler $day_of_week)
                ?(?$filler $AM_PM_spoken)
                ?$filler ?$time_modifier
                [ $hour_number  {%
                                    this.hour = this.hour_number._nl
                                    this.min = '00'
                                %}
                ?(?: $minutes_number{%this.min=this.minutes_number._nl%})
                $AM_PM ]
                ?(o\'clock)
                ?(?$filler $AM_PM_spoken)
                ?(?$filler $day_of_week)
                ?(?$filler $AM_PM_spoken)
            )
            |
            (
                ?$filler ?$time_modifier
                $hour_spoken    {%
                                    this.hour=this.hour_spoken._nl
                                    this.min='00'
                                %}
                ?($minutes_spoken {%this.min=this.minutes_spoken._nl%})
                ?(o\'clock)
                ?(?$filler $AM_PM_spoken| [$AM_PM])
                ?(o\'clock)
                ?(?$filler $day_of_week)
                ?(?$filler $AM_PM_spoken)
            )
            |
            (
                ?(?$filler $day_of_week)
                ?$filler ?$time_modifier
                (
                    noon {%this.ampm='PM'%} |
                    midnight {%this.ampm='AM'%}
                )
                    {%
                        this.hour='12'
                        this.min='00'
                    %}
                ?(?$filler $day_of_week)
            )
        )
        {%

            if (this.ampm) {}
            else if (this.AM_PM) {this.ampm = this.AM_PM._nl}
            else if (this.AM_PM_spoken) {this.ampm = this.AM_PM_spoken._nl}
            else {this.ampm = 'null'}

            if (this.day_of_week) {this.dow = this.day_of_week._nl}
            else {this.dow = 'null'}

            if (this.time_modifier){
                this.modifier = this.time_modifier.modifier
                if (this.modifier > 0){
                    this.min_temp = String(this.modifier)
                } else if(this.hour == 1){
                    this.hour = '12'
                    this.min_temp = String(60+this.modifier)
                } else {
                    this.hour = String(parseInt(this.hour)-1)
                    this.min_temp = String(60+this.modifier)

                    if (this.hour == '11' & this.ampm == 'AM') {this.ampm = 'PM'}
                    else if (this.hour == '11' & this.ampm == 'PM') {this.ampm = 'AM'}
                }

                if (this.min_temp.length < 2){this.min = '0'.concat(this.min_temp)}
                else {this.min = this.min_temp}

            }


            this.time = this.hour + ':' + this.min
            this.rel ='null'
            this.nl = this.time
        %}
        |
        (
            ?$filler
            ?($day_of_week ?$filler)
            $relative_time
            ?(?$filler $day_of_week)
        )
        {%
            if (this.day_of_week) {this.dow=this.day_of_week._nl}
            else {this.dow='null'}

            this.time = 'null'
            this.rel = this.relative_time._nl
            this.ampm = this.relative_time._ampm
            this.nl = this.rel
        %}

        ;

relative_time = (
                 morning{_nl = 'morning'}{_ampm='AM'} |
                 afternoon{_nl = 'afternoon'}{_ampm='PM'} |
                 night{_nl = 'night'}{_ampm='PM'} |
                 evening{_nl = 'evening'}{_ampm='PM'} |
                 dawn{_nl = 'dawn'}{_ampm='AM'} |
                 sunrise{_nl = 'sunrise'}{_ampm='AM'} |
                 sunset{_nl = 'sunset'}{_ampm='PM'} |
                 $AM_ALONE {_nl = 'am'}{_ampm='AM'} |
                 $PM_ALONE {_nl = 'pm'}{_ampm='PM'} |
                 $relative_time_future {_nl=relative_time_future._nl}{_ampm='null'} |
                 $relative_time_past {_nl=relative_time_past._nl}{_ampm='null'}
                )
                ;

relative_time_future =
(
    (in $relative_time_numeric) |
    (after $relative_time_numeric) |
    ($relative_time_numeric from now)
)
{_nl=relative_time_numeric._hours}{_nl+='h'}
{_nl+=relative_time_numeric._minutes}{_nl+='m'}
{_nl+=relative_time_numeric._seconds}{_nl+='s'}
;


relative_time_past =
(
    ($relative_time_numeric ago) |
    ($relative_time_numeric before now)
)
{_nl='-'}
{_nl+=relative_time_numeric._hours}{_nl+='h'}
{_nl+=relative_time_numeric._minutes}{_nl+='m'}
{_nl+=relative_time_numeric._seconds}{_nl+='s'}
;
AM_ALONE = (am) | (a m) | (a. m.) | (a.m.);
PM_ALONE = (pm) | (p m) | (p. m.) | (p.m.);

hour_spoken = ( one {_nl='1'} |
                two {_nl='2'} |
                three {_nl='3'} |
                four {_nl='4'} |
                five {_nl='5'} |
                six {_nl='6'} |
                seven {_nl='7'} |
                eight {_nl='8'} |
                nine {_nl='9'} |
                ten {_nl='10'} |
                eleven {_nl='11'} |
                twelve {_nl='12'} );



minutes_spoken_zero = zero|oh{_nl='00'};

minutes_spoken_digit = one {_nl='1'} |
                 two {_nl='2'} |
                 three {_nl='3'} |
                 four {_nl='4'} |
                 five {_nl='5'} |
                 six {_nl='6'} |
                 seven {_nl='7'} |
                 eight {_nl='8'} |
                 nine {_nl='9'};

minutes_spoken_tens = twenty {_nl = '2'} |
                thirty {_nl = '3'} |
                forty {_nl = '4'} |
                fifty {_nl = '5'};

minutes_spoken_teens = ten{_nl = '10'} |
                 eleven {_nl = '11'} |
                 twelve {_nl = '12'} |
                 thirteen {_nl= '13'} |
                 fourteen {_nl = '14'} |
                 fifteen {_nl = '15'} |
                 sixteen {_nl = '16'} |
                 seventeen {_nl = '17'} |
                 eighteen { _nl = '18'} |
                 nineteen { _nl = '19' };

minutes_spoken = ($minutes_spoken_zero $minutes_spoken_digit){_nl = '0'}{_nl += minutes_spoken_digit._nl} |
                   $minutes_spoken_teens{_nl = minutes_spoken_teens._nl} |
                   $minutes_spoken_tens{_nl = minutes_spoken_tens._nl}{_nl += '0'} |
                   ($minutes_spoken_tens{_nl = minutes_spoken_tens._nl} $minutes_spoken_digit{_nl+=minutes_spoken_digit._nl});


modifier_minutes_number [
                    (?($minutes_first_digit {_nl=minutes_first_digit._nl}) $minutes_second_digit {_nl+=minutes_second_digit._nl})
               ];

modifier_minutes_spoken = (?$minutes_spoken_zero $minutes_spoken_digit){_nl = '0'}{_nl += minutes_spoken_digit._nl} |
                   $minutes_spoken_teens{_nl = minutes_spoken_teens._nl} |
                   $minutes_spoken_tens{_nl = minutes_spoken_tens._nl}{_nl += '0'} |
                   ($minutes_spoken_tens{_nl = minutes_spoken_tens._nl} $minutes_spoken_digit{_nl+=minutes_spoken_digit._nl});

time_modifier =     (half past){%this.modifier=30%} |
                    (quarter past|after){%this.modifier=15%} |
                    (quarter [til?l]|to|before|(?short of)){%this.modifier=-15%} |
                    ($modifier_minutes_spoken ?minutes past|after){%this.modifier=parseInt(this.modifier_minutes_spoken._nl)%} |
                    ($modifier_minutes_spoken ?minutes [til?l]|to|before|(?short of)){%this.modifier=-1*parseInt(this.modifier_minutes_spoken._nl)%} |
                    ([$modifier_minutes_number] ?[minute?s] past|after){%this.modifier=parseInt(this.modifier_minutes_number._nl)%} |
                    ([$modifier_minutes_number] ?[minute?s] [til?l]|to|before|(?short of)){%this.modifier=-1*parseInt(this.modifier_minutes_number._nl)%}
;


AM_PM [
        (am{_nl='AM'}) |
        (a.m.{_nl='AM'}) |
        (pm{_nl='PM'}) |
        (p.m.{_nl='PM'})
      ];

AM_PM_spoken =
     morning {_nl='AM'} |
     afternoon {_nl='PM'} |
     evening {_nl='PM'} |
     night {_nl='PM'} |
     noon {_nl='PM'} |
     midnight {_nl='AM'} |
     $AM_ALONE {_nl='AM'} |
     $PM_ALONE {_nl='PM'}
    ;

hour_number [
                (0  {_nl='00'} )  |
                (00 {_nl='00'} )  |
                (1  {_nl='01'} )  |
                (01 {_nl='01'} )  |
                (2  {_nl='02'} )  |
                (02 {_nl='02'} )  |
                (3  {_nl='03'} )  |
                (03 {_nl='03'} )  |
                (4  {_nl='04'} )  |
                (04 {_nl='04'} )  |
                (5  {_nl='05'} )  |
                (05 {_nl='05'} )  |
                (6  {_nl='06'} )  |
                (06 {_nl='06'} )  |
                (7  {_nl='07'} )  |
                (07 {_nl='07'} )  |
                (8  {_nl='08'} )  |
                (08 {_nl='08'} )  |
                (9  {_nl='09'} )  |
                (09 {_nl='09'} )  |
                (10 {_nl='10'} )  |
                (11 {_nl='11'} )  |
                (12 {_nl='12'} )
            ];

minutes_number [
                    ($minutes_first_digit {_nl=minutes_first_digit._nl} $minutes_second_digit {_nl+=minutes_second_digit._nl})
               ];


minutes_first_digit [
                        (0 {_nl='0'})  |
                        (1 {_nl='1'})  |
                        (2 {_nl='2'})  |
                        (3 {_nl='3'})  |
                        (4 {_nl='4'})  |
                        (5 {_nl='5'})
                    ];

minutes_second_digit [
                        (0{_nl='0'}) |
                        (1{_nl='1'}) |
                        (2{_nl='2'}) |
                        (3{_nl='3'}) |
                        (4{_nl='4'}) |
                        (5{_nl='5'}) |
                        (6{_nl='6'}) |
                        (7{_nl='7'}) |
                        (8{_nl='8'}) |
                        (9{_nl='9'})
                    ];

filler = (?tomorrow ?in|on|at|by|around ?the|this|next);

#Relative Time Numeric
relative_time_numeric = (    $f_HOURS     {_hours=f_HOURS._hours}{_minutes='0'}{_seconds='0'}
                     ?($* $f_MINUTES)  {_minutes=f_MINUTES._minutes}
                     ?($* $f_SECONDS)  {_seconds=f_SECONDS._seconds} ) |
          (    $f_MINUTES   {_hours='0'}{_minutes=f_MINUTES._minutes}{_seconds='0'}
                     ?($* $f_SECONDS)  {_seconds=f_SECONDS._seconds} ) |
          (    $f_SECONDS   {_hours='0'}{_minutes='0'}{_seconds=f_SECONDS._seconds} )
;

f_HOURS = $f_number [hour?s] {_hours=f_number._nl};
f_MINUTES = $f_number [minute?s] {_minutes=f_number._nl};
f_SECONDS = $f_number [second?s] {_seconds=f_number._nl};

f_digit_numeric [ 0{_nl='0'}|
                  1{_nl='1'}|
                  2{_nl='2'}|
                  3{_nl='3'}|
                  4{_nl='4'}|
                  5{_nl='5'}|
                  6{_nl='6'}|
                  7{_nl='7'}|
                  8{_nl='8'}|
                  9{_nl='9'} ];

f_number_numeric = [$f_digit_numeric{_nl=f_digit_numeric._nl} *$f_digit_numeric{_nl+=f_digit_numeric._nl}];

f_digit_spoken = one {_nl='1'} |
                 two {_nl='2'} |
                 three {_nl='3'} |
                 four {_nl='4'} |
                 five {_nl='5'} |
                 six {_nl='6'} |
                 seven {_nl='7'} |
                 eight {_nl='8'} |
                 nine {_nl='9'};

f_tens_spoken = twenty {_nl = '2'} |
                thirty {_nl = '3'} |
                forty {_nl = '4'} |
                fifty {_nl = '5'} |
                sixty {_nl = '6'} |
                seventy {_nl = '7'} |
                eighty {_nl = '8'} |
                ninety {_nl = '9'};

f_teens_spoken = ten{_nl = '10'} |
                 eleven {_nl = '11'} |
                 twelve {_nl = '12'} |
                 thirteen {_nl= '13'} |
                 fourteen {_nl = '14'} |
                 fifteen {_nl = '15'} |
                 sixteen {_nl = '16'} |
                 seventeen {_nl = '17'} |
                 eighteen { _nl = '18'} |
                 nineteen { _nl = '19' };

f_1_to_99_spoken = $f_digit_spoken{_nl = f_digit_spoken._nl} |
                   $f_teens_spoken{_nl = f_teens_spoken._nl} |
                   $f_tens_spoken{_nl = f_tens_spoken._nl}{_nl += '0'} |
                   ($f_tens_spoken{_nl = f_tens_spoken._nl} $f_digit_spoken{_nl+=f_digit_spoken._nl});

f_1_to_999_spoken = $f_1_to_99_spoken{_nl = f_1_to_99_spoken._nl} |
                       ($f_digit_spoken hundred) {_nl = f_digit_spoken._nl}{_nl += '00'} |
                       ($f_digit_spoken hundred $f_1_to_99_spoken){_nl = f_digit_spoken._nl}{_nl += f_1_to_99_spoken._nl};

f_zero_spoken = zero{_nl='0'};

f_number_spoken = $f_zero_spoken {_nl = f_zero_spoken._nl} |
                  $f_1_to_99_spoken {_nl = f_1_to_99_spoken._nl} |
                  $f_1_to_999_spoken {_nl = f_1_to_999_spoken._nl};

f_number = $f_number_spoken {_nl = f_number_spoken._nl} |
           $f_number_numeric {_nl = f_number_numeric._nl};

day_of_week = (
        [M|monday?,] {_nl='monday'} |
        [T|tuesday?,] {_nl='tuesday'} |
        [W|wednesday?,] {_nl='wednesday'} |
        [T|thursday?,] {_nl='thursday'} |
        [F|friday?,] {_nl='friday'} |
        [S|saturday?,] {_nl='saturday'} |
        [S|sunday?,] {_nl='sunday'}
);
