TopRule = ($year) {_year_nl=year._nl}{%delete this.year%};

year = [
    ($number {_nl = number._nl}
    $number {_nl += number._nl}
    $number {_nl += number._nl}
    $number {_nl += number._nl})
        ] |

    (
     [$number {_nl = number._nl}
      $number {_nl += number._nl}]

     [$number {_nl += number._nl}
      $number {_nl += number._nl}]
    ) |

    ($two_digit_number_in_words{_nl = two_digit_number_in_words._nl}
     $two_digit_number_in_words{_nl += two_digit_number_in_words._nl}) |

    ($one_to_nine thousand{_nl = one_to_nine._nl}{_nl += '0'} $two_digit_number_in_words{_nl += two_digit_number_in_words._nl}) |

    ($one_to_nine thousand{_nl = one_to_nine._nl}{_nl += '00'} $one_to_nine{_nl += one_to_nine._nl}) |

    ($one_to_nine thousand{_nl = one_to_nine._nl}{_nl += '000'})
;

two_digit_number_in_words = (
    (oh {_nl='0'} $one_to_nine {_nl+=one_to_nine._nl}) |
    ($teens {_nl=teens._nl}) |
    ($tens {_nl=tens._nl} {_nl+='0'} ) |
    ($tens {_nl=tens._nl} $one_to_nine{_nl+=one_to_nine._nl} )
);

teens = eleven{_nl='11'} |
        twelve{_nl='12'} |
        thirteen{_nl='13'} |
        fourteen{_nl='14'} |
        fifteen{_nl='15'} |
        sixteen{_nl='16'} |
        seventeen{_nl='17'} |
        eighteen{_nl='18'} |
        nineteen{_nl='19'};

tens = twenty{_nl='2'} |
       thirty{_nl='3'} |
       forty{_nl='4'} |
       fifty{_nl='5'} |
       sixty{_nl='6'} |
       seventy{_nl='7'} |
       eighty{_nl='8'} |
       ninety{_nl='9'};

one_to_nine =
    one {_nl='1'} |
    two {_nl='2'} |
    three {_nl='3'} |
    four {_nl='4'} |
    five {_nl='5'} |
    six {_nl='6'} |
    seven {_nl='7'} |
    eight {_nl='8'} |
    nine {_nl='9'}
;

number [
          0{_nl='0'} |
          1{_nl='1'} |
          2{_nl='2'} |
          3{_nl='3'} |
          4{_nl='4'} |
          5{_nl='5'} |
          6{_nl='6'} |
          7{_nl='7'} |
          8{_nl='8'} |
          9{_nl='9'}
       ];
