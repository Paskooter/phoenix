      "input":{"shape":"CreateRequest"},
      "output":{"shape":"CommandResponse"},
      "documentation":"<p> Creates new robot. </p> <p> <note> Can only be called by manufacturing account </note> </p>"
    },
    "CreateRobotBatch":{
      "name":"CreateRobotBatch",
      "input":{"shape":"CreateRequests"},
      "output":{"shape":"CommandResponse"},
      "documentation":"<p> Creates new robots. </p> <p> <note> Can only be called by manufacturing account </note> </p>"
    },
    "CalibrateRobot":{
      "name":"CalibrateRobot",
      "input":{"shape":"CalibrateRequest"},
      "output":{"shape": "CommandResponse"},
      "documentation":"<p> Calibrates robot. </p> <p> <note> Can only be called by manufacturing account </note> </p>"
    }
  },
  "shapes":{
    "Id":{"type":"string"},
    "SerialNumber":{"type":"string"},
    "Payload":{"type":"object"},
