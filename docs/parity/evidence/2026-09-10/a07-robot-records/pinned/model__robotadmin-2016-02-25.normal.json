    "IdRequest":{
      "type":"structure",
      "required":["id"],
      "members":{
        "id":{"shape":"Id"},
        "serialNumber":{"shape":"SerialNumber"}
      }
    },
    "CommandResponse":{
      "type":"structure",
      "required":[
        "result"
      ],
      "members":{
        "result":{"type":"string"}
      }
    },
    "CreateRequest":{
      "type":"structure",
