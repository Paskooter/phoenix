{
  "metadata":{
    "apiVersion":"2015-03-09",
    "endpointPrefix":"log",
    "jsonVersion":"1.1",
    "serviceFullName":"Jibo Log",
    "signatureVersion":"v4",
    "targetPrefix":"Log_20150309",
    "protocol":"json"
  },
  "documentation":"<fullname>Jibo Logs API Reference</fullname> <p>This is the <i>Jibo Logs API Reference</i>. Jibo Logs.",
  "operations":{
    "PutEvents":{
      "name":"PutEvents",
      "input":{"shape":"PutEventsRequest"},
      "output":{"shape":"Response"},
      "documentation":"<p> Uploads a batch of log events to server. </p>"
    },
    "PutEventsAsync":{
      "name":"PutEventsAsync",
      "input":{"shape":"PutEventsAsyncRequest"},
      "output":{"shape":"PutEventsAsyncResponse"},
      "documentation":"<p> Gets uploadUrl to upload a RAW robot log file to S3. </p>"
    },
    "NewKinesisCredentials":{
      "name":"NewKinesisCredentials",
      "input":{"shape":"NewKinesisCredentialsRequest"},
      "output":{"shape":"NewKinesisCredentialsResponse"},
      "documentation":"<p> Generates temporary credentials to upload logs to AWS Kinesis. </p>"
    },
    "PutBinary":{
      "input":{"shape":"PutBinaryRequest"},
      "output":{"shape":"PutBinaryResponse"},
      "documentation":"<p> Uploads a binary that will be later associated with several log entries. </p>"
    },
    "PutBinaryAsync":{
      "input":{"shape":"PutBinaryAsyncRequest"},
      "output":{"shape":"PutBinaryAsyncResponse"},
      "documentation":"<p> Gets uploadUrl to upload a binary that will be later associated with several log entries. </p>"
    },
    "PutAsrBinary":{
      "input":{"shape":"PutAsrBinaryRequest"},
      "output":{"shape":"PutAsrBinaryResponse"},
      "documentation":"<p> Gets uploadUrl to upload a binary that will be later associated with several log entries. </p>"
    }
  },
  "shapes":{
    "Timestamp":{
      "type":"long",
      "min":0,
      "documentation":"A point in time expressed as the number milliseconds since Jan 1, 1970 00:00:00 UTC."
    },
    "Payload":{
      "type":"object",
      "documentation":"Arbitrary JSON data."
    },
    "Metadata":{
      "type": "map",
      "key": {
        "type": "string"
      },
      "value": {
        "type": "string"
      },
      "documentation":"Object metadata. Arbitrary key-value pairs"
    },
    "EventMessage":{
      "type":"string",
      "min":1,
      "max":32768
    },
    "Level":{
      "type":"string",
      "enum":["error","warn","info","verbose","debug","silly"]
    },
    "Kind":{
      "type":"string",
      "enum":["LOG","HEALTH"]
    },
    "Serial":{
      "type":"string",
      "min":1,
      "max":32
    },
    "ContentEncoding":{
      "type":"string",
      "enum":["gzip"]
    },
    "InputEvent":{
      "type":"structure",
      "required":[
        "created"
      ],
      "members":{
        "created":{"shape":"Timestamp"},
        "payload":{"shape":"Payload"},
        "message":{"shape":"EventMessage"},
        "level":{"shape":"Level"}
      },
      "documentation":"A log event is a record of some activity that was recorded by the application or resource being monitored."
    },
    "InputEvents":{
      "type":"list",
      "member":{"shape":"InputEvent"},
      "min":1,
      "max":1000,
      "documentation":"A list of events belonging to a log stream."
    },
    "DeviceId":{
      "type":"string",
      "min":1,
      "max":512,
      "pattern":"[\\.\\-_/#A-Za-z0-9]+"
    },
    "TrackingId":{
      "type":"string",
      "min":1,
      "max":512,
      "pattern":"[\\.\\-_/#A-Za-z0-9]+",
      "documentation":"Random identifier used to group logs coming from one source."
    },
    "PutEventsRequest":{
      "type":"structure",
      "required":[
        "events"
      ],
      "members":{
        "trackingId":{"shape":"TrackingId"},
        "deviceId":{"shape":"DeviceId"},
        "events":{"shape":"InputEvents"}
      }
    },
    "Response":{
      "type":"string",
      "min":1,
      "max":32768
    },
    "Stream":{
      "type":"blob",
      "streaming":true
    },
    "PutBinaryRequest":{
      "type":"structure",
      "members":{
        "trackingId":{
          "shape":"TrackingId",
          "location":"header",
          "locationName":"x-tracking-id"
        },
        "body":{"shape":"Stream"}
      },
      "payload":"body"
    },
    "PutBinaryResponse":{
      "type":"structure",
      "required":[
        "url"
      ],
      "members":{
        "path":{"type":"string"},
        "url":{"type":"string"}
      }
    },
    "PutEventsAsyncRequest":{
      "type":"structure",
      "required":[
        "kind",
        "serial"
      ],
      "members":{
        "kind":{"shape":"Kind"},
        "serial":{"shape":"Serial"}
      }
    },
    "PutEventsAsyncResponse":{
      "type":"structure",
      "required":[
        "contentEncoding",
        "uploadUrl"
      ],
      "members":{
        "contentEncoding":{"shape":"ContentEncoding"},
        "uploadUrl":{"type":"string"}
      }
    },
    "PutBinaryAsyncRequest":{
      "type":"structure",
      "members":{
        "trackingId":{"shape":"TrackingId"}
      }
    },
    "PutBinaryAsyncResponse":{
      "type":"structure",
      "required":[
        "url",
        "uploadUrl"
      ],
      "members":{
        "path":{"type":"string"},
        "url":{"type":"string"},
        "uploadUrl":{"type":"string"}
      }
    },
    "PutAsrBinaryRequest":{
      "type":"structure",
      "required":[
        "trackingId"
      ],
      "members":{
        "trackingId":{"shape":"TrackingId"},
        "metadata":{"shape":"Metadata"}
      }
    },
    "PutAsrBinaryResponse":{
      "type":"structure",
      "required":[
        "bucketName",
        "key",
        "uploadUrl"
      ],
      "members":{
        "bucketName":{"type":"string"},
        "key":{"type":"string"},
        "metadata":{"shape":"Metadata"},
        "uploadUrl":{"type":"string"}
      }
    },
    "NewKinesisCredentialsRequest":{
      "type":"structure",
      "members":{}
    },
    "NewKinesisCredentialsResponse": {
      "type":"structure",
      "required":[
        "credentials",
        "region",
        "streamName"
      ],
      "members":{
        "credentials":{"shape":"StsCredentials"},
        "region":{"type":"string"},
        "streamName":{"type":"string"}
      }
    },
    "StsCredentials": {
      "type":"structure",
      "required":[
        "AccessKeyId",
        "Expiration",
        "SecretAccessKey",
        "SessionToken"
      ],
      "members":{
        "AccessKeyId":{"type":"string"},
        "Expiration":{"type":"string"},
        "SecretAccessKey":{"type":"string"},
        "SessionToken":{"type":"string"}
      }
    }
  }
}
