  "semantics": {
    "plainCharacterClassWord": "new_word produces one parenthesized atom per decoded UTF-8 code point; OPTIONAL_ELTYPE bypasses only the first subsequent atom because processWORD_ELTYPE consumes the or flag and clears it.",
    "explicitGroup": "Parenthesized content is wrapped with OPENPARENT_ELTYPE/CLOSEPARENT_ELTYPE; processOPENPARENT_ELTYPE and processCLOSEPARENT_ELTYPE preserve the optional epsilon branch around the complete group.",
    "normalRuleWord": "Normal rule-content words receive an additional outer put_parentheses, so their optional operand boundary differs from an ungrouped character-class word.",
    "escapedOperator": "A backslash plus a special character is lexed as WORD_OR_VALUE and the backslash is removed; the resulting '?' is literal data.",
    "utf8": "TextIterator advances by code point and new_utf8_char groups all bytes of a valid 1-4 byte code point, so optionality cannot split a valid multibyte character."
  },
  "vectors": [
